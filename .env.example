# Supabase (get from https://supabase.com → your project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (get from https://resend.com → API Keys)
RESEND_API_KEY=re_yourkey
NEWSLETTER_FROM_EMAIL=Dr. Esther <newsletter@yourdomain.com>

# Admin email — only this user can access /admin (set to Dr. Esther's email)
ADMIN_EMAIL=esther@kaysdentalclinic.com

# Site
NEXT_PUBLIC_SITE_URL=https://kays-dental-clinic-blog.vercel.app
